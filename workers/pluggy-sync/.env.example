# Copie para `.env` neste mesmo diretório antes de `docker compose up`.
# Nunca commite o `.env` real (já coberto por .gitignore: padrão `.env`).

# ── Neon / Postgres (única fonte de dados — ADR-009) ──
# Connection string lida por `getDb()` (@sbf/db). Use a URL POOLED do Neon
# (host `-pooler`): este worker abre conexões curtas e repetidas.
# Não existe DATABASE_URL_UNPOOLED aqui de propósito — `@sbf/db` só lê
# DATABASE_URL; um segundo nome sem leitor seria só ruído.
DATABASE_URL=

# ── Dono dos dados ──
# OPCIONAL. Por padrão o worker lê o usuário com role='owner' direto do banco,
# que é a fonte da verdade. Só preencha para forçar outro usuário — e o valor é
# validado na largada: se não existir em public.users, o worker recusa subir em
# vez de gravar linhas em nome de ninguém.
LOCAL_USER_ID=

# ── Pluggy (Meu Pluggy → app → credenciais) ──
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ── Loop do container (opcional) ──
# Intervalo entre rodadas de sync incremental, em segundos. Default 3600 (1h).
SYNC_INTERVAL_SECONDS=3600
