# Copie para `.env` neste mesmo diretório antes de `docker compose up`.
# Nunca commite o `.env` real (já coberto por .gitignore: padrão `.env`).

# ── Supabase (produção ou branch de dev — ver plano Fase 1) ──
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── App de usuário único (ADR-007) ──
LOCAL_USER_ID=

# ── Pluggy (Meu Pluggy → app → credenciais) ──
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ── Loop do container (opcional) ──
# Intervalo entre rodadas de sync incremental, em segundos. Default 3600 (1h).
SYNC_INTERVAL_SECONDS=3600
