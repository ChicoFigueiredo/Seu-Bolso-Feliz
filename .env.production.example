# Produção. Copie para .env.production e complete.
# Guia: docs/_atual/cfg.fornecedores.md
# Checklist de subida: docs/_atual/_checklist.imediato.md
#
# Ambiente ÚNICO: não há staging. A premissa é um único usuário (o CEO).

# ── Identidade dos workers e do MCP (rodam sem sessão) ──
# Normalmente desnecessária: workers e MCP resolvem o dono lendo
# public.users WHERE role='owner'. Só defina para forçar outro usuário (ex.:
# ambiente de teste) — se apontar para um id que não existe em public.users,
# o processo falha na largada em vez de gravar linhas órfãs.
LOCAL_USER_ID=

# ── App ──
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
NODE_ENV=production

# ── Storage: Vercel Blob ──
# Guarda os arquivos originais: boletos, faturas, comprovantes. Os blobs são
# privados; o navegador só chega neles por URL assinada de vida curta.
# Onde pegar: painel da Vercel → Storage → a loja de Blob → ".env.local".
# O Vercel injeta esta variável sozinho no projeto conectado à loja; ela ainda
# precisa ser copiada à mão para os workers e o MCP, que rodam fora da Vercel.
BLOB_READ_WRITE_TOKEN=

# ── Gmail ──
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_LITE_MODEL=gpt-4o-mini
OPENAI_FULL_MODEL=gpt-4o

# ── OCR (máquina local) ──
INGESTION_ENABLE_OCRMYPDF=false
OCRMYPDF_BIN=ocrmypdf

# ── Operação dos workers ──
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
WATCH_DIR=./inbox
SCAN_INTERVAL_MS=30000
