# Produção. Copie para .env.production e complete.
# Guia: docs/_atual/cfg.fornecedores.md
# Checklist de subida: docs/_atual/_checklist.imediato.md
#
# Ambiente ÚNICO: não há staging. A premissa é um único usuário (o CEO).

# ── Supabase (web) ──
#
# Chaves NOVAS, obrigatoriamente. Formato esperado:
#   publicável → sb_publishable_...   (vai ao navegador; respeita RLS)
#   secreta    → sb_secret_...        (ignora RLS; só backend)
#
# Se o valor começar com `eyJ`, é uma chave legacy (anon / service_role) — ela
# não pode ser rotacionada e vence no fim de 2026. Troque antes de subir.
# Criar em: Settings → API Keys → aba "Publishable and secret API keys".
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Supabase (workers e MCP, na máquina local) ──
SUPABASE_URL=https://seu-projeto.supabase.co
# NUNCA no Vercel nem em qualquer variável NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
LOCAL_USER_ID=

# ── Supabase CLI ──
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=seu_project_id_aqui
SUPABASE_DB_PASSWORD=sua_db_password_aqui

# ── App ──
NEXT_PUBLIC_APP_URL=https://seudominio.com.br
NODE_ENV=production

# ── Gmail ──
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_LITE_MODEL=gpt-4o-mini
OPENAI_FULL_MODEL=gpt-4o

# ── OCR (máquina local) ──
INGESTION_ENABLE_OCRMYPDF=false
OCRMYPDF_BIN=ocrmypdf

# ── Operação dos workers ──
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
WATCH_DIR=./inbox
SCAN_INTERVAL_MS=30000
