{
  "regra": "conta-neoenergia",
  "nome": "Conta de energia · Neoenergia",
  "motivo": "regra de fábrica: conta de energia da Neoenergia; propõe conciliar com o compromisso Luz",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "conta-neoenergia",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 10,
    "detectar": {
      "todos": [
        {
          "contem": "neoenergia"
        },
        {
          "contem": "vencimento"
        }
      ]
    },
    "extrair": {
      "valor_centavos": {
        "regex": "(?i)(?:(?:total\\s+a\\s+pagar|valor\\s+a\\s+pagar|valor\\s+total|total\\s+da\\s+fatura|valor\\s+da\\s+fatura))[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "vencimento": {
        "regex": "(?i)(?:vencimento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "data": {
        "regex": "(?i)(?:vencimento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "codigo_cliente": {
        "regex": "(?i)(?:c\\S{0,2}digo\\s+do\\s+cliente|n\\S{0,2}mero\\s+do\\s+cliente|unidade\\s+consumidora|instala\\S{1,3}o)[^\\d\\n]{0,15}(\\d[\\d.\\-/]{2,20}\\d)",
        "formato": "texto"
      },
      "competencia": {
        "regex": "(?i)(?:m\\S*s\\s+de\\s+refer\\S+|refer\\S+ncia)[^\\d\\n]{0,20}(\\d{2}/\\d{4})",
        "formato": "competencia"
      }
    },
    "obrigatorios": [
      "valor_centavos",
      "data"
    ],
    "propor": [
      {
        "conciliar_ocorrencia": {
          "janela_dias": 5,
          "compromisso": "Luz"
        }
      }
    ]
  },
  "exemplos": [
