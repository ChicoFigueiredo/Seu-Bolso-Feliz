{
  "regra": "fatura-cartao-caixa",
  "nome": "Fatura de cartão · CAIXA (Visa/Elo)",
  "motivo": "regra de fábrica: fatura do cartão CAIXA (Visa ou Elo); propõe pagar a fatura",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "fatura-cartao-caixa",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 10,
    "detectar": {
      "todos": [
        {
          "regex": "(?i)\\A(?:[^\\n]*\\n){0,2}[^\\n]*(?:\\bcaixa\\b)"
        },
        {
          "contem": "total da fatura"
        },
        {
          "contem": "vencimento"
        }
      ]
    },
    "extrair": {
      "valor_centavos": {
        "regex": "(?i)(?:total\\s+da\\s+fatura)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "vencimento": {
        "regex": "(?i)(?:vencimento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "pagamento_minimo_centavos": {
        "regex": "(?i)(?:pagamento\\s+m\\S*nimo)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "fechamento": {
        "regex": "(?i)(?:fechamento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "cartao": {
        "regex": "(?i)final\\s+(\\d{4})",
        "formato": "texto"
      },
      "bandeira": {
        "regex": "(?i)\\b(mastercard|visa|elo)\\b",
        "formato": "minusculas"
      }
    },
    "obrigatorios": [
      "valor_centavos",
      "vencimento"
    ],
    "propor": [
      "pagar_fatura"
    ]
  },
  "exemplos": [
