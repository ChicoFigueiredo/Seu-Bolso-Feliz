  "regra": "caixa-habitacao-fgts",
  "nome": "CAIXA Habitação · Uso do FGTS",
  "motivo": "regra de fábrica: amortização extraordinária ou abatimento do saldo devedor com o FGTS",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "uso-do-fgts-caixa-habitacao",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 20,
    "detectar": {
