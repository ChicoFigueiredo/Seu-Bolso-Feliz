      ],
      "algum": [
        {
          "contem": "amortizacao extraordinaria"
        },
        {
          "contem": "abatimento"
        }
      ]
    },
    "extrair": {
      "valor_utilizado_centavos": {
        "regex": "(?i)(?:valor\\s+utilizado)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "modalidade": {
        "regex": "(?i)(amortiza\\S+\\s+extraordin\\S+|abatimento)",
        "formato": "minusculas"
      },
      "data": {
        "regex": "(?i)(?:data)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "saldo_devedor_centavos": {
        "regex": "(?i)(?:saldo\\s+devedor)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "contrato": {
        "regex": "(?i)contrato[^\\d\\n]{0,20}(?:\\n[^\\d\\n]{0,10})?(\\d[\\d.\\-/]{5,24}\\d)",
        "formato": "texto"
      }
    },
    "obrigatorios": [
      "valor_utilizado_centavos"
    ],
    "propor": [],
    "texto_de_ocr": true
  },
