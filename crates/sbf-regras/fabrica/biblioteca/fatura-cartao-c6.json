{
  "regra": "fatura-cartao-c6",
  "nome": "Fatura de cartão · C6 Bank",
  "motivo": "regra de fábrica: fatura do cartão C6; propõe pagar a fatura com o débito do banco",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "fatura-cartao-c6",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 10,
    "detectar": {
      "todos": [
        {
          "regex": "(?i)\\A(?:[^\\n]*\\n){0,2}[^\\n]*(?:\\bc6\\b)"
        },
        {
          "contem": "total da fatura"
        },
        {
          "contem": "vencimento"
        }
      ]
    },
    "extrair": {
      "valor_centavos": {
        "regex": "(?i)(?:total\\s+da\\s+fatura)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "vencimento": {
        "regex": "(?i)(?:vencimento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "pagamento_minimo_centavos": {
        "regex": "(?i)(?:pagamento\\s+m\\S*nimo)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "fechamento": {
        "regex": "(?i)(?:fechamento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "cartao": {
        "regex": "(?i)final\\s+(\\d{4})",
        "formato": "texto"
      },
      "bandeira": {
        "regex": "(?i)\\b(mastercard|visa|elo)\\b",
        "formato": "minusculas"
      }
    },
    "obrigatorios": [
      "valor_centavos",
      "vencimento"
    ],
    "propor": [
      "pagar_fatura"
    ]
  },
  "exemplos": [
    {
      "nome": "fatura com cartão final e fechamento",
      "texto": "C6 Bank\nFatura do cartão C6 Mastercard final 0000\nVencimento 10/12/2026\nFechamento 03/12/2026\nTotal da fatura R$ 2.345,67\nPagamento mínimo R$ 351,85\n",
      "esperado": {
        "esperado": "reconhece",
        "tipo_documental": "fatura-cartao-c6",
        "campos": {
