{
  "regra": "caixa-habitacao-comprovante-prestacao",
  "nome": "CAIXA Habitação · Comprovante de pagamento de prestação",
  "motivo": "regra de fábrica: lê o comprovante (print do app) com amortização, juros, taxas e saldo devedor; propõe conciliar com a Prestação Casa",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "comprovante-prestacao-caixa-habitacao",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 10,
    "detectar": {
      "todos": [
        {
          "contem": "comprovante de pagamento"
        },
        {
          "contem": "pagamento de prestacao"
        }
      ]
    },
    "extrair": {
      "valor_centavos": {
        "regex": "(?i)(?:valor\\s+pago)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "valor_prestacao_centavos": {
        "regex": "(?i)(?:valor\\s+da\\s+presta\\S+)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "valor_devido_centavos": {
        "regex": "(?i)(?:valor\\s+devido)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "amortizacao_centavos": {
        "regex": "(?i)(?:amortiza\\S*)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "juros_centavos": {
        "regex": "(?i)(?:\\bjuros\\b)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "taxas_centavos": {
        "regex": "(?i)(?:\\btaxas?\\b)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "encargo_liquido_centavos": {
        "regex": "(?i)(?:encargo\\s+l\\S*quido)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "valor_diferenca_centavos": {
        "regex": "(?i)(?:valor\\s+da\\s+diferen\\S+)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "correcao_monetaria_centavos": {
        "regex": "(?i)(?:corre\\S*\\s+monet\\S+)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "saldo_devedor_centavos": {
        "regex": "(?i)(?:saldo\\s+devedor)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "vencimento": {
        "regex": "(?i)(?:data\\s+de\\s+vencimento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "data": {
        "regex": "(?i)(?:data\\s+de\\s+pagamento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "contrato": {
        "regex": "(?i)contrato[^\\d\\n]{0,20}(?:\\n[^\\d\\n]{0,10})?(\\d[\\d.\\-/]{5,24}\\d)",
        "formato": "texto"
      }
    },
    "obrigatorios": [
      "valor_centavos",
      "data"
    ],
    "propor": [
      {
        "conciliar_ocorrencia": {
          "janela_dias": 5,
          "compromisso": "Prestação Casa"
        }
      }
    ],
    "texto_de_ocr": true
