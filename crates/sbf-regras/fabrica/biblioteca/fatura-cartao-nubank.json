{
  "regra": "fatura-cartao-nubank",
  "nome": "Fatura de cartão · Nubank",
  "motivo": "regra de fábrica: fatura do cartão Nubank (vencimento por extenso lido pelo script); propõe pagar a fatura",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "fatura-cartao-nubank",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 10,
    "detectar": {
      "todos": [
        {
          "contem": "fatura"
        },
        {
          "contem": "pagamento minimo"
        }
      ],
      "algum": [
        {
          "contem": "nubank"
        },
        {
          "contem": "nu pagamentos"
        }
      ],
      "nenhum": [
        {
          "regex": "(?i)\\A(?:[^\\n]*\\n){0,2}[^\\n]*(?:\\bcaixa\\b)"
        },
        {
          "regex": "(?i)\\A(?:[^\\n]*\\n){0,2}[^\\n]*(?:\\bc6\\b)"
        }
      ]
    },
    "extrair": {
      "valor_centavos": {
        "regex": "(?i)(?:(?:total\\s+da\\s+fatura|valor\\s+da\\s+fatura|total\\s+a\\s+pagar))[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "vencimento": {
        "regex": "(?i)(?:vencimento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "pagamento_minimo_centavos": {
        "regex": "(?i)(?:pagamento\\s+m\\S*nimo)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "fechamento": {
        "regex": "(?i)(?:fechamento)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "cartao": {
        "regex": "(?i)final\\s+(\\d{4})",
        "formato": "texto"
      },
      "bandeira": {
        "regex": "(?i)\\b(mastercard|visa|elo)\\b",
        "formato": "minusculas"
      }
    },
    "obrigatorios": [
      "valor_centavos",
      "vencimento"
    ],
    "script_le_texto": true,
    "propor": [
      "pagar_fatura"
    ]
  },
  "exemplos": [
    {
      "nome": "vencimento por extenso",
      "texto": "Nubank\nOlá, Fulano de Tal.\nEsta é a sua fatura de novembro.\nData de vencimento: 15 DEZ 2026\nTotal da fatura R$ 2.345,67\nPagamento mínimo R$ 351,85\nCartão final 0000\n",
