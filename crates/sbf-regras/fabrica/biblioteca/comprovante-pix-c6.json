{
  "regra": "comprovante-pix-c6",
  "nome": "Comprovante Pix · C6 Bank",
  "motivo": "regra de fábrica: comprovante de Pix emitido pelo C6 Bank; propõe provar o débito",
  "definicao": {
    "versao_do_esquema": 1,
    "tipo_documental": "comprovante-pix-c6",
    "aplica_a": [
      "documento"
    ],
    "prioridade": 10,
    "detectar": {
      "todos": [
        {
          "regex": "(?i)\\A(?:[^\\n]*\\n){0,2}[^\\n]*(?:\\bc6\\b)"
        },
        {
          "contem": "pix"
        },
        {
          "contem": "comprovante"
        }
      ],
      "nenhum": [
        {
          "contem": "pagamento minimo"
        }
      ]
    },
    "extrair": {
      "valor_centavos": {
        "regex": "(?i)(?:valor)[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{1,3}(?:\\.\\d{3})+,\\d{2}|\\d+,\\d{2})",
        "formato": "centavos"
      },
      "data": {
        "regex": "(?i)(?:(?:data|realizad\\S+\\s+em|efetivad\\S+\\s+em))[^\\d\\n]{0,25}(?:\\n[^\\d\\n]{0,25})?(\\d{2}/\\d{2}/\\d{4})",
        "formato": "data"
      },
      "favorecido": {
        "regex": "(?im)^[ \\t]*(?:para|favorecido|destinat\\S*|recebedor)[ \\t]*:?[ \\t]*\\n?[ \\t]*([^\\n]{3,80})$",
        "formato": "texto"
      },
      "documento_favorecido": {
        "regex": "(?i)(?:cpf\\s*/\\s*cnpj|cpf|cnpj)[ \\t]*:?[ \\t]*([\\d.*\\-/]{11,18})",
        "formato": "texto"
      },
      "instituicao": {
        "regex": "(?im)^[ \\t]*institui\\S*[ \\t]*:?[ \\t]*([^\\n]{3,60})$",
        "formato": "texto"
      },
      "autenticacao": {
        "regex": "(?i)autentica\\S*[ \\t]*:?[ \\t]*\\n?[ \\t]*([A-Za-z0-9.\\-]{8,64})",
        "formato": "texto"
      },
      "id_transacao": {
        "regex": "(?i)id\\s+(?:da\\s+)?transa\\S*[ \\t]*:?[ \\t]*\\n?[ \\t]*([A-Za-z0-9]{20,40})",
        "formato": "texto"
      }
    },
    "obrigatorios": [
      "valor_centavos",
      "data"
    ],
    "propor": [
      {
        "provar_registro": {
          "janela_dias": 2
        }
      }
    ]
  },
  "exemplos": [
    {
      "nome": "Pix enviado com destinatário na linha de baixo",
