            "valor": "Banco Exemplo S.A."
          },
          "id_transacao": {
            "tipo": "texto",
            "valor": "E00000000202611121432NUBAN00001"
          }
        }
      }
    },
    {
      "nome": "data numérica",
      "texto": "Nu Pagamentos S.A.\nComprovante Pix\nValor R$ 45,90\nData 30/11/2026\nDestino\nNome Fulano de Tal\n",
