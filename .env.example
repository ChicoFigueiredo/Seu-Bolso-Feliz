# ── Banco: Neon (Postgres) ──
# Fonte única de dados. A pooled é a do dia a dia; a unpooled é obrigatória
# para LISTEN/NOTIFY (a fila de jobs) — o pooler não entrega notificação de
# forma confiável.
DATABASE_URL=postgresql://usuario:senha@ep-xxx-pooler.região.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxx.região.aws.neon.tech/neondb?sslmode=require

# ── Autenticação própria ──
# Assina o cookie de sessão. Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessões — é o botão de "deslogar tudo".
AUTH_SECRET=
# Quem pode entrar pelo Google. Sem isto, só o dono.
AUTH_ALLOWED_EMAILS=fran.fig@gmail.com
# Credenciais OAuth do Google Cloud Console. A URL de retorno autorizada lá
# precisa incluir <origem>/auth/callback — antes quem falava com o Google era
# o Supabase, então a URL registrada é a dele e precisa ser trocada.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Senha inicial do usuário admin@ (a chave reserva, para quando o Google
# falhar). Mínimo 12 caracteres. Vira hash no banco no primeiro login por
# senha; depois disso pode ser trocada sem redeploy.
ADMIN_INITIAL_PASSWORD=

# ── Storage: S3 (SeaweedFS na VPS) ──
# Guarda os arquivos originais: boletos, faturas, comprovantes.
S3_ENDPOINT=https://s3.seu-dominio.com.br
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# SeaweedFS exige path-style; virtual-host não funciona.
S3_FORCE_PATH_STYLE=true

# ── Workers ──
# Capacidades que este worker oferece. A fila só entrega a ele os jobs cujas
# exigências cabem aqui. VPS: ocr. Máquina local: ocr,pasta-local,senha-pdf.
WORKER_CAPABILITIES=ocr

# Copie para .env e complete.
# Guia completo: docs/_atual/cfg.fornecedores.md


# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Gmail (só para ingestão por e-mail) ──
# Obter o refresh token: bun run get:gmail-token
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── IA (chat, sugestões inline e enriquecimento da ingestão) ──
# Escolha UM provedor. Se as duas chaves existirem, a do OpenRouter vence.
OPENAI_API_KEY=
# OpenRouter, ou qualquer API compatível com a da OpenAI (Ollama, LiteLLM…).
# Com esta chave definida, a base vira https://openrouter.ai/api/v1 sozinha e
# os modelos passam a levar prefixo de fornecedor: openai/gpt-4o,
# anthropic/claude-3.5-sonnet, google/gemini-2.0-flash…
# OPENROUTER_API_KEY=
# Só para apontar a um endpoint próprio; sobrepõe a escolha automática acima.
# OPENAI_BASE_URL=

# Modelos da ingestão (workers)
OPENAI_LITE_MODEL=gpt-4o-mini
OPENAI_FULL_MODEL=gpt-4o
# Modelos da web
AI_CHAT_MODEL=gpt-4o
AI_SUGGEST_MODEL=gpt-4o-mini

# ── OCR ──
# Desligado por padrão: depende de binário externo, e ligá-lo sozinho faria o
# worker falhar em máquina sem ele.
#
# PDF escaneado — requer: sudo apt install ocrmypdf tesseract-ocr-por
INGESTION_ENABLE_OCRMYPDF=false
OCRMYPDF_BIN=ocrmypdf
#
# Imagem (foto de boleto pelo celular) — requer:
#   sudo apt install tesseract-ocr tesseract-ocr-por
# Sem isto, imagem entra no pipeline e sai com texto vazio.
INGESTION_ENABLE_IMAGE_OCR=false
TESSERACT_BIN=tesseract
INGESTION_OCR_LANG=por+eng

# ── Operação dos workers ──
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
WATCH_DIR=./inbox
SCAN_INTERVAL_MS=30000
