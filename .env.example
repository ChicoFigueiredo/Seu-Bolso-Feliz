# Copie para .env e complete.
# Guia completo: docs/_atual/cfg.fornecedores.md

# ── Supabase (web) ──
#
# Use SEMPRE as chaves novas: publicável `sb_publishable_...` e secreta
# `sb_secret_...`. As legacy (`anon` / `service_role`, no formato JWT `eyJ...`)
# não podem ser rotacionadas e param de existir no fim de 2026.
#
# Os valores locais são fixos — embutidos no binário do CLI, idênticos em
# qualquer máquina — e saem de `supabase status`. A publicável fica aqui como
# referência; a secreta fica em branco de propósito: mesmo local e não
# sensível, o padrão `sb_secret_...` aciona o secret scanning do GitHub.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# ── Supabase (workers e MCP) ──
# Mesmo valor de NEXT_PUBLIC_SUPABASE_URL. As duas são necessárias: o Next só
# expõe ao navegador variáveis com prefixo NEXT_PUBLIC_, e os workers não rodam
# dentro do Next.
SUPABASE_URL=http://127.0.0.1:54321
# Chave secreta — ignora RLS. NUNCA no navegador, nunca no Vercel. Rode
# `supabase status` e cole o valor de SECRET_KEY aqui.
SUPABASE_SECRET_KEY=

# UUID do seu usuário em auth.users. Workers e MCP rodam sem sessão de
# autenticação, então precisam saber de quem são os dados.
#   select id, email from auth.users;
LOCAL_USER_ID=

# ── Supabase CLI (scripts e CI) ──
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=sua-senha-aqui

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Gmail (só para ingestão por e-mail) ──
# Obter o refresh token: bun run get:gmail-token
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── IA (chat, sugestões inline e enriquecimento da ingestão) ──
# Escolha UM provedor. Se as duas chaves existirem, a do OpenRouter vence.
OPENAI_API_KEY=
# OpenRouter, ou qualquer API compatível com a da OpenAI (Ollama, LiteLLM…).
# Com esta chave definida, a base vira https://openrouter.ai/api/v1 sozinha e
# os modelos passam a levar prefixo de fornecedor: openai/gpt-4o,
# anthropic/claude-3.5-sonnet, google/gemini-2.0-flash…
# OPENROUTER_API_KEY=
# Só para apontar a um endpoint próprio; sobrepõe a escolha automática acima.
# OPENAI_BASE_URL=

# Modelos da ingestão (workers)
OPENAI_LITE_MODEL=gpt-4o-mini
OPENAI_FULL_MODEL=gpt-4o
# Modelos da web
AI_CHAT_MODEL=gpt-4o
AI_SUGGEST_MODEL=gpt-4o-mini

# ── OCR ──
# Desligado por padrão: depende de binário externo, e ligá-lo sozinho faria o
# worker falhar em máquina sem ele.
#
# PDF escaneado — requer: sudo apt install ocrmypdf tesseract-ocr-por
INGESTION_ENABLE_OCRMYPDF=false
OCRMYPDF_BIN=ocrmypdf
#
# Imagem (foto de boleto pelo celular) — requer:
#   sudo apt install tesseract-ocr tesseract-ocr-por
# Sem isto, imagem entra no pipeline e sai com texto vazio.
INGESTION_ENABLE_IMAGE_OCR=false
TESSERACT_BIN=tesseract
INGESTION_OCR_LANG=por+eng

# ── Operação dos workers ──
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
WATCH_DIR=./inbox
SCAN_INTERVAL_MS=30000
